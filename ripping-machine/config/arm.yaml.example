# arm.yaml — configuration template for ARM (Automatic Ripping Machine)
# Copy to ripping-machine/config/arm.yaml and fill in your own keys.

ARM_NAME: "LocalRipper"
ARM_CHILDREN: ""

PREVENT_99: false
ARM_CHECK_UDF: true
UMASK: 0o002
GET_VIDEO_TITLE: true
ARM_API_KEY: ""
DISABLE_LOGIN: false

# LOSSLESS MODE
SKIP_TRANSCODE: true
VIDEOTYPE: "auto"
MINLENGTH: "600"
MAXLENGTH: "99999"
MANUAL_WAIT: true
MANUAL_WAIT_TIME: 60
DATE_FORMAT: "%d-%m-%Y %H:%M:%S"
ALLOW_DUPLICATES: true
MAX_CONCURRENT_TRANSCODES: 0
MAX_CONCURRENT_MAKEMKVINFO: 0
DATA_RIP_PARAMETERS: ""
METADATA_PROVIDER: "omdb"
GET_AUDIO_TITLE: "musicbrainz"
RIP_POSTER: false
AUTO_EJECT: true

ABCDE_CONFIG_FILE: "/etc/arm/config/abcde.conf"
RAW_PATH: "/home/arm/media/raw/"
TRANSCODE_PATH: "/home/arm/media/transcode/"
COMPLETED_PATH: "/home/arm/media/completed/"
EXTRAS_SUB: "extras"
INSTALLPATH: "/opt/arm/"
LOGPATH: "/home/arm/logs/"
LOGLEVEL: "INFO"
LOGLIFE: 7
DBFILE: "/home/arm/db/arm.db"

WEBSERVER_IP: x.x.x.x
WEBSERVER_PORT: 8080
UI_BASE_URL: ""

SET_MEDIA_PERMISSIONS: true
CHMOD_VALUE: 775
SET_MEDIA_OWNER: false
CHOWN_USER:
CHOWN_GROUP:

# === FILL IN YOUR KEYS ===
MAKEMKV_PERMA_KEY: ""       # Get from https://makemkv.com/buy/ or buy a licence
RIPMETHOD: "mkv"
RIPMETHOD_DVD: "PLACEHOLDER"
RIPMETHOD_BR: "PLACEHOLDER"
MKV_ARGS: ""
DELRAWFILES: true

HB_PRESET_DVD: "HQ 720p30 Surround"
HB_PRESET_BD: "HQ 1080p30 Surround"
DEST_EXT: mkv
HANDBRAKE_CLI: HandBrakeCLI
HANDBRAKE_LOCAL: HandBrakeCLI
MAINFEATURE: false
HB_ARGS_DVD: "--subtitle scan -F"
HB_ARGS_BD: "--subtitle scan -F --subtitle-burned --audio-lang-list eng --all-audio"

USE_FFMPEG: false
FFMPEG_CLI: FFMPEG
FFMPEG_LOCAL: FFMPEG
FFMPEG_PRE_FILE_ARGS:
FFMPEG_POST_FILE_ARGS:

NOTIFY_RIP: true
NOTIFY_TRANSCODE: false
NOTIFY_JOBID: false
PB_KEY: ""
IFTTT_KEY: ""
IFTTT_EVENT: "arm_event"
PO_USER_KEY: ""
PO_APP_KEY: ""
BASH_SCRIPT: ""

OMDB_API_KEY: ""            # Free key from https://www.omdbapi.com/
TMDB_API_KEY: ""
JSON_URL: ""
APPRISE: ""
