# Required: full URL to the pipeline API on the main machine
# Use the machine's local network IP (not localhost)
PIPELINE_API=http://192.168.1.XXX:8090

# Optional — override these defaults if needed
NODE_ID=node2
USE_GPU=true
PARALLEL_JOBS=1
TARGET_HEIGHT=1080
UPSCALE_MODEL=RealESRGAN_x4plus
DENOISE_STRENGTH=3
AUDIO_CLEANUP=true
AUDIO_NOISE_FLOOR=-25
